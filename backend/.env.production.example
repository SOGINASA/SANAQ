# Copy this file to backend/.env on the production server.
# Generate both secrets independently with: openssl rand -hex 32
FLASK_ENV=production
PORT=8000

SECRET_KEY=replace-with-a-unique-random-value
JWT_SECRET_KEY=replace-with-another-unique-random-value

# SQLite is persisted through the ./database Docker volume mapping.
# Use an absolute /app path because this value is read inside the container.
DATABASE_URL=sqlite:////app/database/sanaq.db

# Exact frontend origins only, comma-separated, without a trailing slash.
CORS_ORIGINS=https://app.example.com
FRONTEND_URL=https://app.example.com

# Keep these credentials on the backend only. Register the exact callback URL
# as an Authorized redirect URI in Google Cloud Console.
GOOGLE_CLIENT_ID=replace-with-google-oauth-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-oauth-client-secret
GOOGLE_REDIRECT_URI=https://app.example.com/api/v1/auth/google/callback

# Passkeys require HTTPS outside localhost. RP ID must be the frontend hostname.
WEBAUTHN_RP_ID=app.example.com
WEBAUTHN_ORIGINS=https://app.example.com
WEBAUTHN_RP_NAME=SANAQ

# Initialize explicitly with `flask --app app init-db`; do not create or seed
# data implicitly on every production process start.
AUTO_CREATE_DB=false
MIGRATE_RUNTIME_SCHEMA=true
SEED_DEMO_DATA=false
JWT_COOKIE_SECURE=true
SESSION_COOKIE_SECURE=true
DEFAULT_LOCALE=ru
DATA_MODE=production

# Keep one Gunicorn worker with SQLite to reduce concurrent write contention.
GUNICORN_WORKERS=1
GUNICORN_THREADS=4

# Groq is called only by the backend. Never expose this key through frontend
# variables, browser code, API responses, logs, or Git.
GROQ_API_KEY=gsk_replace_with_server_secret
AI_PROVIDER=groq
AI_BASE_URL=https://api.groq.com/openai/v1
AI_MODEL=llama-3.1-8b-instant
AI_PROMPT_VERSION=sana-tutor-v1
AI_TIMEOUT_SECONDS=30
AI_TEMPERATURE=0.3
AI_MAX_TOKENS=500
AI_CONTEXT_TOKENS=8192
AI_RATE_LIMIT_PER_MINUTE=10
AI_DAILY_TOKEN_LIMIT=20000

PATHNET_MODE=shadow
PATHNET_MODEL_PATH=/app/ml/artifacts/pathnet-v2-outcomes-notebook.pt
PATHNET_TOP_K=20
PATHNET_CANARY_PERCENT=0
