FLASK_ENV=development
PORT=8000

# Replace both values outside local development.
SECRET_KEY=change-this-secret-key-before-deploying-sanaq
JWT_SECRET_KEY=change-this-jwt-secret-before-deploying-sanaq

# Without DATABASE_URL the backend uses backend/database/sanaq.db.
# DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/sanaq

CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
AUTO_CREATE_DB=true
MIGRATE_RUNTIME_SCHEMA=true
SEED_DEMO_DATA=true
JWT_COOKIE_SECURE=false
DEFAULT_LOCALE=ru
DATA_MODE=demo_seed

# Local Qwen3 through Ollama. When backend runs in Docker, use
# http://host.docker.internal:11434 instead.
AI_PROVIDER=ollama
AI_BASE_URL=http://127.0.0.1:11434
AI_MODEL=qwen3:8b
AI_PROMPT_VERSION=sana-tutor-v1
AI_TIMEOUT_SECONDS=60
AI_TEMPERATURE=0.3
AI_MAX_TOKENS=500
AI_CONTEXT_TOKENS=8192
AI_THINKING=false
