# Use explicit URLs in local development. CRA's legacy `proxy` option can pass
# an empty allowedHost to webpack-dev-server on machines without a LAN address.
# Production values can remain relative when Nginx proxies `/api/v1`.
REACT_APP_API_URL=http://127.0.0.1:8000/api/v1
REACT_APP_AI_STREAM_URL=http://127.0.0.1:8000/api/v1
REACT_APP_DEFAULT_LOCALE=ru
REACT_APP_ENABLE_MOCKS=false
REACT_APP_SHOW_DEMO_LOGIN=true
