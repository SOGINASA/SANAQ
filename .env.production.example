# Copy to .env on the server and replace every change-me value.
SECRET_KEY=change-me-with-openssl-rand-hex-32
JWT_SECRET_KEY=change-me-with-another-openssl-rand-hex-32
POSTGRES_PASSWORD=change-me-with-a-long-random-password

# Public address of the application. Use HTTPS on a real domain.
PUBLIC_ORIGIN=http://localhost
HTTP_PORT=80
JWT_COOKIE_SECURE=false

DEFAULT_LOCALE=ru
DATA_MODE=production
SEED_DEMO_DATA=false
AUTO_CREATE_DB=true
MIGRATE_RUNTIME_SCHEMA=true

# Backend-only Groq credential. Never expose it through REACT_APP_* variables.
GROQ_API_KEY=gsk_replace_with_server_secret
AI_MODEL=llama-3.1-8b-instant
AI_TIMEOUT_SECONDS=30
AI_TEMPERATURE=0.3
AI_MAX_TOKENS=500
AI_CONTEXT_TOKENS=8192
AI_RATE_LIMIT_PER_MINUTE=10
AI_DAILY_TOKEN_LIMIT=20000

PATHNET_MODE=shadow
PATHNET_TOP_K=20
PATHNET_CANARY_PERCENT=0
GUNICORN_WORKERS=2
GUNICORN_THREADS=4
TORCH_VERSION=2.11.0
